from string import ascii_uppercase
import numpy as np

# What phrase will be used to test the user's typing?
PHRASE = "the quick brown fox jumps over the lazy dog"
# What should the seed start at?
SEED = 25

def generate(use_seed, phrase, num_symbols):
    seed = SEED

    sequence = [char.upper() for char in PHRASE if char != ' ']

    keyboard_values = []
    target_values = []

    for char in sequence:
        if use_seed:
            rng = np.random.default_rng(seed=seed)
        else: 
            rng = np.random.default_rng()
        
        user_symbol_idx = rng.integers(low=0, high=num_symbols, size=len(ascii_uppercase))
        all_letters = dict(zip(ascii_uppercase, user_symbol_idx))
        keyboard_values.append(all_letters)
        target_values.append(all_letters[char])
        seed += 1
    
    print(target_values)

    test_trg = "["
    for idx, char in enumerate(sequence):
        test_trg = test_trg + str(keyboard_values[idx][char]) + ", "
    test_trg += "]"

    print(test_trg)

    if phrase:
        return keyboard_values
    else:
        return target_values

generate(True, True, 3)